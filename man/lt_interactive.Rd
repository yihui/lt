# an initial sort by cyl, then mpg descending within each (two equivalent
# forms: a character vector, or a formula)
lt(mtcars) |> lt_interactive(sort = c('cyl', '-mpg'))
lt(mtcars) |> lt_interactive(sort = ~ cyl + -mpg)
